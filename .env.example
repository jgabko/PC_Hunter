# Copie este arquivo para ".env" (sem o .example) e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Chave da API da Groq - gere uma nova em https://console.groq.com/keys
# IMPORTANTE: se você já commitou uma chave antes, revogue-a e gere outra.
GROQ_API_KEY=coloque_sua_chave_aqui

# true = usa Groq (nuvem, rápido); false = usa Ollama local
USE_GROQ=true

# Opcional - só altere se quiser mudar a busca padrão
OLX_BASE_URL=https://www.olx.com.br/estado-pr?q=pc
DB_NAME=olx.db
